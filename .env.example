# Copy to .env in the Ubuntu VM and replace the credential placeholders first.
POSTGRES_DB=event_management
POSTGRES_USER=replace_with_local_db_user
POSTGRES_PASSWORD=replace_with_a_unique_local_password

# Better Auth settings for the local Nginx origin. Generate a new 32+ character secret for .env.
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=replace_with_a_random_secret_at_least_32_characters
